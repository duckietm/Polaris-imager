# --- avatar-imaging-pixinode spike ---------------------------------------------
# Copy to .env. Point these at the SAME hotel gamedata/assets the browser
# service uses, so both engines render identical input for a fair comparison.

# REQUIRED: where the hotel serves gamedata + .nitro assets (mirror the client's
# renderer-config.json gamedata.url / asset.url). NITRO_GAMEDATA_URL must be the
# directory that DIRECTLY contains FigureData.json / FigureMap.json /
# EffectMap.json / HabboAvatarActions.json.
NITRO_GAMEDATA_URL=https://hotel.example.com/client/gamedata
NITRO_ASSET_URL=https://hotel.example.com/client/nitro/bundled

# Optional per-file overrides (only if your layout differs), e.g. for a layout
# like http://192.168.0.8/gamedata/{config,clothes,effect}:
#   NITRO_GAMEDATA_URL=http://192.168.0.8/gamedata/config
#   NITRO_AVATAR_ASSET_URL=http://192.168.0.8/gamedata/clothes/%libname%.nitro
#   NITRO_AVATAR_ASSET_EFFECT_URL=http://192.168.0.8/gamedata/effect/%libname%.nitro
# NITRO_AVATAR_ACTIONS_URL=
# NITRO_AVATAR_FIGUREDATA_URL=
# NITRO_AVATAR_FIGUREMAP_URL=
# NITRO_AVATAR_EFFECTMAP_URL=
# NITRO_AVATAR_MANDATORY_LIBRARIES=bd:1,li:0
# NITRO_AVATAR_MANDATORY_EFFECT_LIBRARIES=dance.1,dance.2,dance.3,dance.4

# Animation playback rate for APNG output + a hard frame cap.
AVATAR_IMAGING_FPS=12
AVATAR_IMAGING_MAX_FRAMES=60

# Point the build at a specific renderer checkout instead of the yarn-link.
# NITRO_RENDERER_PATH=/path/to/Nitro-Renderer

# --- HTTP service (npm start) -------------------------------------------------
# Only used by src/server.mjs; the CLI (render.mjs) ignores these.
AVATAR_IMAGING_HOST=0.0.0.0
AVATAR_IMAGING_PORT=8082
# Per-render + boot time budgets (ms).
# AVATAR_IMAGING_RENDER_TIMEOUT_MS=30000
# AVATAR_IMAGING_BOOT_TIMEOUT_MS=60000
# Response cache (in-memory LRU keyed by the full query).
# AVATAR_IMAGING_CACHE_ENTRIES=512
# AVATAR_IMAGING_CACHE_MAX_BYTES=268435456
# AVATAR_IMAGING_CACHE_TTL_MS=300000
# Bump to invalidate clients' cached copies after regenerating gamedata/assets.
# AVATAR_IMAGING_ASSET_VERSION=
# Shed load: 503 once this many requests are already queued for the renderer.
# AVATAR_IMAGING_MAX_QUEUE=16
# Per-IP rate limit (fixed window). Set max to 0 to disable.
# AVATAR_IMAGING_RATELIMIT_WINDOW_MS=60000
# AVATAR_IMAGING_RATELIMIT_MAX=120
# Comma-separated API keys; when set, requests need ?key= or X-API-Key. Empty => public.
# AVATAR_IMAGING_API_KEYS=
# CORS allow-origin for /avatarimage (e.g. https://cms.example or *). Empty => none.
# AVATAR_IMAGING_CORS_ORIGIN=
# Behind a reverse proxy: "true", a hop count, or a subnet; + the real-IP header.
# AVATAR_IMAGING_TRUST_PROXY=true
# AVATAR_IMAGING_CLIENT_IP_HEADER=x-forwarded-for
# Access log to a rotating file instead of stdout.
# AVATAR_IMAGING_LOG_FILE=/var/log/avatar-imaging-pixinode/access.log
# Verbose per-render effect diagnostics.
# AVATAR_IMAGING_DEBUG=0

# Speech-bubble font. node-canvas has no bundled fonts, so text (?text=...) is
# rendered with whatever is registered as "Arial". By default node-env auto-scans
# the standard Linux (Liberation/DejaVu), Windows (C:\Windows\Fonts\arial.ttf) and
# macOS Arial paths — so on Linux `apt-get install fonts-liberation` is enough, and
# Windows/macOS work out of the box. Point these at a specific .ttf for
# byte-identical text across machines (e.g. a real Arial you provide).
# AVATAR_IMAGING_FONT_FILE=/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf
# AVATAR_IMAGING_FONT_FILE_BOLD=/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf

# --- Scene composer (GET /Generate/scene, render on GET /scene) ---------------
# Multi-layer composer: several avatars, images and text in one PNG.
AVATAR_IMAGING_SCENE=1
AVATAR_IMAGING_SCENE_PATH=/scene
AVATAR_IMAGING_SCENE_MAX_LAYERS=24
AVATAR_IMAGING_SCENE_MAX_SIZE=2000
# Extra hosts the SERVER may fetch image layers and backgrounds from. The hosts
# of NITRO_GAMEDATA_URL, NITRO_ASSET_URL and AVATAR_IMAGING_PUBLIC_URL are
# trusted automatically, so your own CDN usually works with nothing set here.
# Add a host and its subdomains become allowed too. Keep this to hosts you own:
# the server fetches these URLs itself. Images from hosts outside the list are
# refused everywhere — preview, PNG export and /scene render alike.
# Set to * to allow any host. Only do that on a trusted network: the server will
# then fetch whatever URL a scene asks for.
AVATAR_IMAGING_SCENE_IMAGE_HOSTS=
# AVATAR_IMAGING_SCENE_MAX_IMAGE_BYTES=4194304
# AVATAR_IMAGING_SCENE_IMAGE_TIMEOUT_MS=8000

# --- Wardrobe ----------------------------------------------------------------
# Visual clothing catalogue built from your FigureData.json, in the panel and in
# the scene composer. Browsing it renders one thumbnail per item, so keep the
# rate limit generous.
AVATAR_IMAGING_WARDROBE=1

# --- Habbo typefaces (scene composer only) -----------------------------------
# Pixel typefaces for scene text layers, built from the sheets in fonts/.
AVATAR_IMAGING_HABBO_FONTS=1

# --- Chat bubble styles ------------------------------------------------------
# Habbo chat bubble sprites from bubbles/, stretched to the message length. Used
# by the panel and by scene avatars: pick a style instead of a bubble colour.
AVATAR_IMAGING_CHAT_BUBBLES=1
